# Twitch API Configuration
# Get these values from https://dev.twitch.tv/console/apps
# Client ID: Your application's Client ID (public identifier)
# Client Secret: Your application's Client Secret (keep this private!)
VITE_TWITCH_CLIENT_ID=your_twitch_client_id_here
VITE_TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Server-side Twitch credentials (required for OAuth + EventSub webhook subscriptions)
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# EventSub webhook configuration
EVENTSUB_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Preferred explicit callback URL (public HTTPS endpoint handled by this app)
EVENTSUB_CALLBACK_URL=https://your-domain.tld/webhooks/eventsub
# Optional fallback base URL when callback URL is not set
EVENTSUB_PUBLIC_BASE_URL=
# Optional host allow-list for computed callback URLs (comma-separated)
EVENTSUB_ALLOWED_HOSTS=

# Optional privileged username allowed to send targeted custom alerts from the dashboard.
# Leave empty to disable targeted custom alerts entirely.
OVERLAY_ADMIN=
